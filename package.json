{
  "name": "shiftwrap",
  "version": "1.0.0",
  "description": "This is a telegram bot that is used to track employees' shift",
  "license": "ISC",
  "author": "thekhaji",
  "main": "dist/server.js",
  "scripts": {
    "start": "node -r tsconfig-paths/register -r ts-node/register src/server.ts",
    "start:dev": "nodemon --exec node -r tsconfig-paths/register -r ts-node/register src/server.ts",
    "build": "tsc",
    "refresh-menus": "node -r tsconfig-paths/register -r ts-node/register src/scripts/refreshMenus.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "grammy": "^1.44.0",
    "mongoose": "^9.7.3",
    "pptxgenjs": "^4.0.1"
  }
}
