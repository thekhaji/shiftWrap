# required
BOT_TOKEN=            # from @BotFather (use a separate bot for development)
MONGO_URL=            # mongodb+srv://... , must be a replica set (Atlas is)

# optional
ADMIN_TELEGRAM_IDS=   # comma separated Telegram ids that are always admins, e.g. 123456789,987654321
ERROR_CHAT_ID=        # Telegram chat id that receives error alerts
DEBUG_UPDATES=false   # true logs every chat id (debugging only)
